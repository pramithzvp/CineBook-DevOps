# Copy to .env; replace both passwords before starting. Do not commit .env.
MYSQL_DATABASE=cinebook_db
MYSQL_USER=cinebook
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_ROOT_PASSWORD
FRONTEND_PORT=3000
# Exact URL used in your laptop browser; no trailing slash.
FRONTEND_ORIGIN=http://192.168.1.50:3000
